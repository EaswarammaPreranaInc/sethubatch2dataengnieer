# sys . path  demo   program
import  sys  # Imports sys module
print('Original  sys.path')  # Prints header
for  x  in   sys . path:  # Iterates through sys.path
	print(x)  # Prints each path entry
print(len(sys . path))  # Prints number of paths in sys.path
#import  cal  # Commented out import
from  random  import  *  # Imports all from random module
print(random())  # Prints random float between 0 and 1
print(randint(1 , 100))  # Prints random integer between 1 and 100
print(uniform(1 , 100))  # Prints random float between 1 and 100
print(randrange(10))  # Prints random integer from 0 to 9
print(randrange(1 , 11))  # Prints random integer from 1 to 10
print(randrange(1 , 11 , 2))  # Prints random odd number from 1 to 9
list = [10 , 20 , 15 , 12 , 18]  # Defines list
print(choice(list))  # Prints random element from list
print(choice('RAJESH'))  # Prints random character from string
set  =  {10 , 20 , 30 , 40}  # Defines set
print(choice(set))  # Prints random element from set (Note: sets are unordered)

