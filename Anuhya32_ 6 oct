import math

class Rat:
    def get(self):   
        self.nr = int(input("Enter numerator : "))
        self.dr = int(input("Enter denominator : "))
        while self.dr == 0:
            self.dr = int(input("Denominator cannot be zero, re-enter : "))

    def _gt_(self, b):  
        return self.nr * b.dr > self.dr * b.nr

    def _lt_(self, b):   
        return self.nr * b.dr < self.dr * b.nr

    def _eq_(self, b):
        return self.nr * b.dr == self.dr * b.nr

    def _ge_(self, b):
        return self.nr * b.dr >= self.dr * b.nr

    def _le_(self, b):
        return self.nr * b.dr <= self.dr * b.nr

    def _ne_(self, b):   # not equal
        return self.nr * b.dr != self.dr * b.nr


