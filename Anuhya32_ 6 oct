import math

class complex:
    def get(self):
        self.real = int(input("Enter real part : "))
        self.imag = int(input("Enter imaginary part : "))

    def _str_(self):   # display in a + bi (or a - bi) format
        if self.imag >= 0:
            return f"{self.real} + {self.imag}i"
        else:
            return f"{self.real} - {abs(self.imag)}i"

    def _add_(a, b):
        r = complex()
        r.real = a.real + b.real
        r.imag = a.imag + b.imag
        return r

    def _sub_(a, b):
        r = complex()
        r.real = a.real - b.real
        r.imag = a.imag - b.imag
        return r

    def _mul_(a, b):
        r = complex()
        r.real = a.real * b.real - a.imag * b.imag
        r.imag = a.real * b.imag + a.imag * b.real
        return r
    
    def _truediv_(a, b):
        r = complex()
        denom = b.real ** 2 + b.imag ** 2
        if denom == 0:
            print("Division not possible (denominator is 0 + 0i)")
            return None
        r.real = (a.real * b.real + a.imag * b.imag) / denom
        r.imag = (a.imag * b.real - a.real * b.imag) / denom
        return r

