def student_list_program():
    n = int(input("Enter number of students: "))
    s = []
    for i in range(n):
        print(f"Student {i+1}")
        obj = student()
        obj.get()
        obj.compute()
        s.append(obj)
    print("\nRoll\tName\tGender\tTotal\tAverage\t\tGrade")
    for i in s:
        print(f"{i.roll}\t{i.name}\t{i.gender}\t{i.total:.1f}\t{i.avg:.2f}\t\t{i.grade}")

