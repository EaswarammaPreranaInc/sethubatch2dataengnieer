class Rat:
    def __init__(self, nr=0, dr=1):
        self.nr = nr
        self.dr = dr
    def __add__(self, other):
        return Rat(self.nr * other.dr + other.nr * self.dr, self.dr * other.dr)
    def __sub__(self, other):
        return Rat(self.nr * other.dr - other.nr * self.dr, self.dr * other.dr)
    def __mul__(self, other):
        return Rat(self.nr * other.nr, self.dr * other.dr)
    def __truediv__(self, other):
        return Rat(self.nr * other.dr, self.dr * other.nr)
    def __str__(self):
        return f'{self.nr}/{self.dr}'

a = Rat(2, 3)
b = Rat(4, 5)
c = a + b
print(c)
c = a - b
print(c)
c = a * b
print(c)
c = a / b
print(c)

