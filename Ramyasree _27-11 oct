1) Write a program to validate emp number, emp name and salary and also print them
 2) Emp number and salary cannot be -ve
 3) Emp name cannot be empty string
 4) Class name is Emp
 5) 3 getter and 3 setter methods
 6) Constructor initializes empno, ename and sal
 7) Outside the class
 a) Create Emp class object
   b) Print empno, ename and sal

class Emp:
	def __init__(self, empno, ename, sal):
		self.empno = empno
		self.ename = ename
		self.sal = sal

	@property
	def empno(self):
		return self._empno

	@empno.setter
	def empno(self, value):
		if value < 0:
			raise ValueError("Employee number cannot be negative")
		self._empno = value

	@property
	def ename(self):
		return self._ename

	@ename.setter
	def ename(self, value):
		if value == '':
			raise ValueError("Employee name cannot be empty")
		self._ename = value

	@property
	def sal(self):
		return self._sal

	@sal.setter
	def sal(self, value):
		if value < 0:
			raise ValueError("Salary cannot be negative")
		self._sal = value

# end of the class

# a) Create Emp class object
e = Emp(101, 'Vamsi', 30000)

# b) Print empno, ename and sal
print("Employee Number :", e.empno)
print("Employee Name   :", e.ename)
print("Salary          :", e.sal)



