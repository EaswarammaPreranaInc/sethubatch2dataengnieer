'''
Modify following program such that

1) Use regular function instead of lambda function
2) Use for loop to iterate filter instead of while loop
'''
import time

list = [25, 9, 10, 15, 17, 24, 35, 47, 0, 19, 53, 18, 65, 83]

def even(x):                   # regular function instead of lambda
	return x % 2 == 0

f = filter(even, list)
print(type(f))                 # <class 'filter'>
print(f)                       # <filter object at 0x000001A2...>

for i in f:                    # using for loop instead of while loop
	print(i)                   # 10  24  0  18
	time.sleep(1)



