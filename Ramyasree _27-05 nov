# Nested filter i.e. filter on filter
import time

list = [
	(10, 'Rama', 10000.0),
	(20, 'Sita', 7000.0),
	(15, 'Rajesh', 15000.0),
	(5, 'Amar', 12000.0),
	(18, 'Ramesh', 8000.0)
]

f = filter(lambda x: x[1].startswith('R'),
           filter(lambda x: x[2] >= 10000, list))

while True:
	try:
		print(next(f))       # (10, 'Rama', 10000.0)
		                     # (15, 'Rajesh', 15000.0)
		time.sleep(1)
	except:
		break
