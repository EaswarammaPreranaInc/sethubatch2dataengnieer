
import sys

class c1:
    pass

a = b = c = d = c1()
print(sys.getrefcount(b))          # 5 (a,b,c,d + temp ref)
print(sys.getrefcount(c1()))       # 1 (temp ref only)
print(sys.getrefcount(352))        # varies (integers cached)
print(sys.getrefcount([10,20,15,18]))   # 1
print(sys.getrefcount(10.8))       # 1
print(sys.getrefcount({10,20,15,18}))   # 1
print(sys.getrefcount('Hyd'))      # may vary, usually 2
print(sys.getrefcount({10:20,30:40}))   # 1
print(sys.getrefcount((10,20,30,40)))   # 1



import sys

class Test:
    def __init__(self):
        print('Constructor : ', id(self))
    def __del__(self):
        print('Destructor : ', id(self))

t = Test()
print("Refcount after creation:", sys.getrefcount(t))
print("Manually calling constructor:", t.__init__())
print("Refcount after constructor call:", sys.getrefcount(t))
print("Manually calling destructor:", t.__del__())
print("Refcount after destructor call:", sys.getrefcount(t))
print('Bye')


# Constructor :  <id>
# Refcount after creation: 2
# Manually calling constructor: None
# Refcount after constructor call: 2
# Manually calling destructor: None
# Refcount after destructor call: 2
# Bye
# Destructor : <id>




