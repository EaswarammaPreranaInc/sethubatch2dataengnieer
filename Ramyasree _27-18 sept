import random

print("Welcome to Rock, Paper, Scissors Game!")
choices = ["Rock", "Paper", "Scissors"]

while True:
    user_input = int(input("What do you want to select (0 - Rock, 1 - Paper, 2 - Scissors) : "))
    user_choice = choices[user_input]
    print("User  :  ", user_choice)

    computer_choice = random.choice(choices)
    print("Computer  :  ", computer_choice)

    if user_choice == computer_choice:
        print("Draw")
    elif (computer_choice == "Paper" and user_choice == "Rock") or \
         (computer_choice == "Scissors" and user_choice == "Paper") or \
         (computer_choice == "Rock" and user_choice == "Scissors"):
        print("Computer wins")
    else:
        print("User wins")

    cont = input("Continue (y/n) ?  ").lower()
    if cont != 'y':
        print("End of the game")
        break








