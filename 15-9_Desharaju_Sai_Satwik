    yield 1
    print('Two')
    yield 2
    print('Three')
    yield 3
    print('End')
g = f1()
for m in g:
    print(m)
x, y, z = f1()
print(x)
print(y)
print(z)
# OUTPUT:
# One
# 1
# Two
# 2
# Three
# 3
# End
# One
# 1
# Two
# 2
# Three
# 3
# End
# 1
# 2
# 3


