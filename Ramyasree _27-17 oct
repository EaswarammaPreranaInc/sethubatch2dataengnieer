# Find outputs (Home work)

class parent:
    a = 10  # Static variable 'a' of parent class
    
    def __init__(self):
        print('Parent constructor')
        self.x = 30  # Instance variable 'x' of parent object

    def m1(self):
        # How to print instance variable 'x'
        print('Parent class instance method:', self.x)

    @classmethod
    def m2(cls):
        # How to print static variable 'a'
        print('Parent class "class" method:', cls.a)
        # Another way
        print('Parent class "class" method another way:', parent.a)

    @staticmethod
    def m3():
        # How to print static variable 'a' inside static method
        print('Parent class static method:', parent.a)

    def __del__(self):
        # How to print instance variable 'x' in destructor
        print('Parent destructor:', self.x)


class child(parent):
    b = 20  # Static variable 'b' of child class

    def __init__(self):
        super().__init__()  # Call parent class constructor
        print('Child constructor')
        self.y = 40  # Instance variable 'y' of child object

    def m1(self):
        super().m1()  # Call m1() of parent class
        print('Child class instance method')
        print(self.y)  # Print instance variable 'y'

    @classmethod
    def m2(cls):
        # Call parent class m2()
        super(child, cls).m2()
        # Another way without creating object
        parent.m2()
        print('Child class "class" method')
        # Print static variables
        print(cls.a)
        print(parent.a)
        print(cls.b)

    @staticmethod
    def m3():
        # Call parent class m3()
        parent.m3()
        print('Child class static method')
        print(child.a)
        print(child.b)

    def __del__(self):
        # Call parent destructor
        super().__del__()
        print('Child destructor:', self.y)


# end of the class

# How to call m2() method of child class
child.m2()
# How to call m3() method of child class
child.m3()
# How to call m1() method of child class
c = child()
