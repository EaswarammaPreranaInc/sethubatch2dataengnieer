# Find outputs and demonstrate method calls in multiple inheritance

class father:  #  Which class defines m1() method for father?
    def m1(self):
        print('m1 method of Father class')
        
class mother:  #  Which class defines m1() method for mother?
    def m1(self):
        print('m1 method of Mother class')
        
class uncle:   #  Which class defines m1() method for uncle?
    def m1(self):
        print('m1 method of Uncle class')
        
class child(father, mother, uncle):  # What is the method resolution order (MRO) here?
    def m1(self):
        print('m1 method of child class') # How to call m1() of father class?
        father.m1(self)#  How to call m1() of mother class?
        mother.m1(self)#  How to call m1() of uncle class?
        uncle.m1(self)# How to call parent class method using super?
        super(father, self).m1()

# End of the class

print(child.__mro__)  # What is the method resolution order of class child?

c = child()
c.m1()  #  What happens when we call m1() on child object?

