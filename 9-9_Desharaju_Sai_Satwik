
def fib(i):  # i = term number
    if i == 0:
        return 0
    if i == 1:
        return 1
    return fib(i - 1) + fib(i - 2)


n = 5
print("fib(5) =", fib(n))  # fib(5) = 5

print("Fibonacci series:")
n = 7
for i in range(n):
    print(fib(i), end=" ")
print("\n")  # Output: 0 1 1 2 3 5 8




def power(a, b):
    if b == 0:
        return 1
    if b > 0:
        return a * power(a, b - 1)
    else:
        return (1 / a) * power(a, b + 1)

print("power(4.5 , 3) =", power(4.5, 3))    # 91.125
print("power(4.5 , -3) =", power(4.5, -3))  # ≈ 0.010989
print()



from math import *

def rev(n):
    if n == 0:
        return 0
    else:
        length = len(str(n))
        return (n % 10) * (10 ** (length - 1)) + rev(n // 10)

print("rev(946) =", rev(946))  # 649
