from  threading  import *
import  time

class Account:
	def __init__(self, acno1, bal1):
		self.acno = acno1
		self.bal = bal1

	def credit(self, amt):
		s = current_thread().name
		print(F'{s} is depositing Rs. {amt} into account {self.acno}')   # Rama / Sita depositing messages
		x = self.bal                                                     # Reads current balance
		time.sleep(1)                                                    # Thread delay — may cause race condition
		self.bal = x + amt                                               # Updates balance
# End of the class


ac = Account(25, 1000.0)
print('Initial  Balance : ', ac.bal)                                    # Initial  Balance :  1000.0

t1 = Thread(target=ac.credit, args=[100], name='Rama')
t2 = Thread(target=ac.credit, args=(200,), name='Sita')

t1.start()                                                              # Rama  is  depositing  Rs. 100 into account 25
t2.start()                                                              # Sita  is  depositing  Rs. 200 into account 25
t1.join()
t2.join()

print('Final  Balance  :  ', ac.bal)                                    # Final  Balance  :  1100.0  or  1200.0 (depends on race condition)



