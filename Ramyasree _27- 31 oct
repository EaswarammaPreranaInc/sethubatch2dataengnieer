import time
def disp(e):
	while True:
		try:
			print(next(e))         # prints each enumerated element
			time.sleep(1)
		except:
			break
	print()

a = {'Empno': 25, 'Emp Name': 'Rama Rao', 'Sal': 10000.0}

e1 = enumerate(a.keys())
disp(e1)
# Output:
# (0, 'Empno')
