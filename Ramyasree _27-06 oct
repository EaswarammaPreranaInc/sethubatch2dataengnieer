import math

class Rat:
    def get(self):
        self.nr = int(input("Enter numerator: "))
        self.dr = int(input("Enter denominator: "))
        while self.dr == 0:
            self.dr = int(input("Denominator cannot be zero, re-enter: "))

    def __gt__(self, b):
        return self.nr * b.dr > self.dr * b.nr

    def __lt__(self, b):
        return self.nr * b.dr < self.dr * b.nr

    def __eq__(self, b):
        return self.nr * b.dr == self.dr * b.nr

    def __ge__(self, b):
        return self.nr * b.dr >= self.dr * b.nr

    def __le__(self, b):
        return self.nr * b.dr <= self.dr * b.nr

    def __ne__(self, b):
        return self.nr * b.dr != self.dr * b.nr

    def __str__(self):
        return f"{self.nr} / {self.dr}"

# --- End of class ---

