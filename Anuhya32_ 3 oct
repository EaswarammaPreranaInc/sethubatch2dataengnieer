class   c1:
	def   _init_(self , k):
		print('c1  class  object  is  created') # c1 class object is created 
		self . b = k
		print('End  of  c1  class constructor') # End of c1 class constructor 
	def   _del_(self):
		print('c1  class  object  is  lost')
# End of class c1
