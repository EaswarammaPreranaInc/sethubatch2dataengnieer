from threading import *
import time

def fact(n):
    sem.acquire()                    # acquire semaphore
    if n > 0:
        x = n * fact(n - 1)          # recursive call
    else:
        x = 1
    sem.release()                    # release semaphore
    return x                         # return factorial value

# End of the function
def disp(n):
    print(n, ' != ', fact(n))
# End of the function

sem = Semaphore(8)                   # allows up to 8 simultaneous acquires

t1 = Thread(target = disp, args = (4,))
t2 = Thread(target = disp, args = (7,))

t1.start()
t2.start()






