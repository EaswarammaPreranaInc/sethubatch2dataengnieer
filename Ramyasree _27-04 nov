# How  to  resolve  deadlock ?
from  threading  import *
import  time

def  f1():
	l1 . acquire()                                   # l1 locked by thread-1
	time . sleep(1)
	l2 . acquire()                                   # waits for l2 (if already taken by thread-2) → DEADLOCK possible
	print('1st  thread  is  under  execution')      
	l2 . release()
	l1 . release()
	print('End  of  the  1st  thread')               # (prints only if released properly)
#  End  of  the  function

def  f2():
	l1 . acquire()                                   # l1 locked by thread-2 (same order → OK)
	time . sleep(1)
	l2 . acquire()                                   # waits for l2 
	print('2nd   thread  is  under  execution')
	l2 . release()
	l1 . release()
	print('End  of  the  2nd   thread')
#  End  of  the  function

l1 = Lock()
l2 = Lock()

t1 = Thread(target = f1)
t2 = Thread(target = f2)
t1 . start()
t2 . start()
t1 . join()
t2 . join()
print('End  of  main  thread')                      # printed last
