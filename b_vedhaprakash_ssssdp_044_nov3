# ---------- 1. Synchronize Thread Outputs ----------
from threading import *
import time

def disp(s):
    print('[', s, end='')
    time.sleep(3)
    print(']')

# Lock object for synchronization
l = Lock()

def sync_disp(s):
    with l:
        disp(s)

t1 = Thread(target=sync_disp, args=('Hyd',))
t2 = Thread(target=sync_disp, args=('Sec',))
t3 = Thread(target=sync_disp, args=('Cyb',))
t1.start(); t2.start(); t3.start()
t1.join(); t2.join(); t3.join()

# Output:
# [Hyd]
# [Sec]
# [Cyb]

# ---------- 2. Final Balance should be 1300 ----------
class Account:
    def __init__(self, acno1, bal1):
        self.acno = acno1
        self.bal = bal1
        self.l = Lock()

    def credit(self, amt):
        with self.l:
            s = current_thread().name
            print(f'{s} is depositing Rs.{amt} into account {self.acno}')
            x = self.bal
            time.sleep(1)
            self.bal = x + amt

ac = Account(25, 1000.0)
print('Initial Balance:', ac.bal)
t1 = Thread(target=ac.credit, name='Rama', args=(100,))
t2 = Thread(target=ac.credit, name='Sita', args=(200,))
t1.start(); t2.start()
t1.join(); t2.join()
print('Final balance:', ac.bal)
# Output: Final balance: 1300.0

# ---------- 3. RLock ----------
from threading import RLock
r = RLock()
r.acquire(); print('Locked')
r.acquire(); print('Locked')
r.release(); print('Unlocked')
r.release(); print('Unlocked')
try:
    r.release()
except RuntimeError:
    print('RuntimeError: cannot release un-acquired lock')
# Output shows nested lock handling, final extra release gives RuntimeError

