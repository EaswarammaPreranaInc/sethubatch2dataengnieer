        self.first = None

    def isempty(self):
        return self.first is None

class circular_linked_list(linkedlist):
    def copy(self):
        b = circular_linked_list()  # How to create a new cll object to hold the result
        if self.first is None:  # If input cll is empty
            print("Output cll is empty")
            return b
        current = self.first
        prev = None
        while True:  # How to copy each node of cll held by object 'a' to 'b'
            new_node = node(current.data)
            if b.first is None:
                b.first = new_node
                prev = new_node
            else:
                prev.next = new_node
                prev = new_node
            current = current.next
            if current == self.first:
                break  # End of while loop
        prev.next = b.first  # Make the copied list circular
        return b  # Return output cll

