    def isempty(self):
        return self.first is None

class circular_linked_list(linkedlist):
    def delete(self, i):
        if self.first is None:
            return None  # i is invalid because list is empty

        if self.first.next == self.first:  # cll has single node
            if i == 1:
                data = self.first.data
                self.first = None
                return data
            else:
                return None  # i is invalid

        if i == 1:  # deletion of first node
            current = self.first
            while current.next != self.first:
                current = current.next
            data = self.first.data
            current.next = self.first.next
            self.first = self.first.next
            return data

        count = 1
        prev = self.first
        current = self.first.next
        while current != self.first:
            count += 1
            if count == i:
                prev.next = current.next  # delete ith node
                return current.data
            prev = current
            current = current.next

        return None  # i is invalid

    def printlist(self):
        if self.first is None:
            print("List is empty")
            return
        current = self.first
        while True:
            print(current.data, end=' ')
