        self.first = None

    def isempty(self):
        return self.first is None

class circular_linked_list(linkedlist):
    def insert(self, i, x):
        new_node = node(x)  # How to create a new node
        
        if self.first is None:  # If cll is empty
            self.first = new_node
            new_node.next = new_node
            return
        
        count = 1
        current = self.first
        while True:
            if count == i:  # Insert after ith node
                new_node.next = current.next
                current.next = new_node
                return
            current = current.next
            count += 1
            if current == self.first:
                break
        print(F'Node {i} does not exist')  # If i is invalid

    def printlist(self):
        if self.first is None:
            print("List is empty")
            return
        current = self.first
        while True:
            print(current.data, end=' ')
            current = current.next
            if current == self.first:
                break
        print()

