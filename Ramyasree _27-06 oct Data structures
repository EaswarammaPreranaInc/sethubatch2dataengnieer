class queue:
    def __init__(self):
        self.q = []

    def isempty(self):
        return len(self.q) == 0

    def enqueue(self, x):
        self.q.append(x)

    def dequeue(self):
        if self.isempty():
            return -1
        return self.q.pop(0)

    def first(self):
        if self.isempty():
            return -1
        return self.q[0]

    def last(self):
        if self.isempty():
            return -1
        return self.q[-1]

    def disp(self):
        print(self.q)

    def size(self):
        return len(self.q)


