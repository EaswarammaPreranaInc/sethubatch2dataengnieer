
def toh(n, p1, p2, p3):
    if n > 0:
        toh(n - 1, p1, p3, p2)
        print(p1, "--->", p3)
        toh(n - 1, p2, p1, p3)

# Example: toh(3, 1, 2, 3)
n = 3
print("Towers of Hanoi with 3 disks:")
toh(n, 1, 2, 3)
print()




