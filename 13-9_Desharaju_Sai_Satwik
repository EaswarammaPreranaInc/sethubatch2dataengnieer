

# Q1
import time
def f1():
    print('One')
    yield 25
    print('Two')
    yield 10.8
    print('Three')
    yield 'Hyd'
    print('Four')
g = f1()
for x in g:
    print(x)
    time.sleep(1)
    print('Hello')
print('End')
print(g)
print(next(g))
g = f1()
print(next(g))
# OUTPUT:
# One
# 25
# Hello
# Two
# 10.8
# Hello
# Three
# Hyd
# Hello
# Four
# End
# <generator object f1 at 0x...>
# error (StopIteration)
# One
# 25


