   "source": [
    "# Full Pyramid Program\n",
    "\n",
    "n = int(input(\"Enter number of lines: \"))\n",
    "\n",
    "for i in range(1, n + 1):       # if user enter 5 - (1,6)\n",
    "    spaces = n - i        # spaces decrease each line\n",
    "    stars = 2 * i - 1      # stars increase as 1, 3, 5, 7, ...\n",
    "    \n",
    "    print(\" \" * spaces + \"*\" * stars)"
   ]
  }
 ],
