Write  a  program  to  delete  a  directory.
Input  is  directory  name  (or)  path  of  the  directory




import os
import shutil
dir_name = input("Enter directory name or path to delete: ")

try:
    
    if os.path.isdir(dir_name):
       
        try:
            os.rmdir(dir_name)
            print(f"Empty directory '{dir_name}' deleted successfully.")
        except OSError:
            shutil.rmtree(dir_name)
            print(f"Directory '{dir_name}' (with all contents) deleted successfully.")
    else:
        print(f"Directory '{dir_name}' does not exist.")
except Exception as e:
    print(f"Error: {e}")




